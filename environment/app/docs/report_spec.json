{
  "workflow_repair": {
    "path": "/app/workflow/resolve_access.py",
    "cli_usage": "python3 /app/workflow/resolve_access.py --input PATH --output-dir PATH",
    "defaults": {
      "input": "/app/data/expanded_bindings.json",
      "output_dir": "/app/output",
      "resource_tree": "/app/data/resource_tree.json",
      "role_catalog": "/app/data/role_catalog.json",
      "access_policies": "/app/data/access_policies.json"
    },
    "prohibited_imports": [
      "sqlite3",
      "pandas",
      "duckdb",
      "networkx"
    ]
  },
  "output_files": {
    "summary_json": "summary.json",
    "principal_decisions_json": "principal_decisions.json",
    "exception_queue_jsonl": "exception_queue.jsonl",
    "additional_files_allowed": false
  },
  "field_types": {
    "principal": {
      "type": "string",
      "input_coercion": "str(principal).strip().lower()"
    },
    "role": {
      "type": "string",
      "input_coercion": "str(role).strip().lower()"
    },
    "permission": {
      "type": "string",
      "input_coercion": "str(permission).strip().lower()"
    },
    "node": {
      "type": "string",
      "input_coercion": "str(node).strip().lower(); empty segments dropped; rendered as '/' + '/'.join(segments), or '/' when no segments remain"
    },
    "effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "decision_basis": {
      "type": "string",
      "enum": [
        "direct_grant",
        "propagated_deny",
        "role_inheritance",
        "scoped_wildcard"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "critical",
        "elevated",
        "routine"
      ]
    },
    "node_depth": {
      "type": "integer"
    },
    "inherit_distance": {
      "type": "integer"
    },
    "scope_specificity": {
      "type": "integer"
    },
    "contest_count": {
      "type": "integer"
    },
    "suppressed_descendants": {
      "type": "integer"
    },
    "risk_score": {
      "type": "integer"
    },
    "escalation_index": {
      "type": "integer"
    },
    "contested_effects": {
      "type": "array",
      "items": "string",
      "order": "ascending"
    },
    "basis_counts": {
      "type": "object",
      "keys": [
        "direct_grant",
        "propagated_deny",
        "role_inheritance",
        "scoped_wildcard"
      ]
    },
    "tier_counts": {
      "type": "object",
      "keys": [
        "critical",
        "elevated",
        "routine"
      ]
    },
    "policy_value": {
      "type": "integer",
      "input_coercion": "int(str(value).strip()); on failure int(float(str(value).strip())); on failure 0"
    },
    "node_effective_principals": {
      "type": "integer"
    }
  },
  "principal_decisions_json": {
    "output_path": "principal_decisions.json",
    "container": "object keyed by principal, each value the array of that principal's decision objects",
    "key_sort": "ascending",
    "item_sort": "node ascending, then permission ascending",
    "required_fields": [
      "node",
      "node_depth",
      "permission",
      "effect",
      "decision_basis",
      "source_binding_id",
      "source_role",
      "source_scope",
      "inherit_distance",
      "scope_specificity",
      "contest_count",
      "contested_effects",
      "suppressed_descendants",
      "risk_score",
      "escalation_index",
      "node_effective_principals"
    ]
  },
  "exception_queue": {
    "output_path": "exception_queue.jsonl",
    "container": "one compact JSON object per line, json.dumps(..., separators=(',', ':'))",
    "decision_id_format": "{principal}:{node}:{permission}",
    "required_fields": [
      "decision_id",
      "principal",
      "node",
      "node_depth",
      "permission",
      "effect",
      "decision_basis",
      "source_binding_id",
      "source_role",
      "source_scope",
      "inherit_distance",
      "scope_specificity",
      "contest_count",
      "contested_effects",
      "suppressed_descendants",
      "risk_score",
      "escalation_index",
      "tier",
      "node_effective_principals"
    ]
  },
  "summary_json": {
    "output_path": "summary.json",
    "container": "object",
    "schema_version": "acl-resolve-v1",
    "required_fields": [
      "schema_version",
      "expanded_binding_count",
      "principal_count",
      "resource_node_count",
      "role_count",
      "resolved_decision_count",
      "allow_decision_count",
      "deny_decision_count",
      "contested_decision_count",
      "basis_counts",
      "tier_counts",
      "total_risk_score",
      "total_escalation_index",
      "total_suppressed_descendants",
      "queued_decision_count",
      "max_risk_score",
      "max_escalation_index",
      "max_contest_count",
      "max_suppressed_descendants",
      "max_effective_principals"
    ],
    "basis_counts_key_order": [
      "direct_grant",
      "propagated_deny",
      "role_inheritance",
      "scoped_wildcard"
    ],
    "tier_counts_key_order": [
      "critical",
      "elevated",
      "routine"
    ]
  },
  "binding_source": {
    "path": "/app/data/role_bindings.json",
    "expanded_path": "/app/data/expanded_bindings.json",
    "shape": "[{\"binding_id\": str, \"principal\": str, \"role\": str, \"scope\": str}, ...]"
  },
  "directory_source": {
    "path": "/app/data/directory_export.json",
    "shape": "{\"export_id\": str, \"groups\": [{\"handle\": str, \"display_name\": str, \"members\": [str, ...], \"nested_groups\": [str, ...]}, ...]}"
  },
  "resource_tree_source": {
    "path": "/app/data/resource_tree.json",
    "shape": "[{\"node\": str, \"parent\": str|null, \"label\": str}, ...]"
  },
  "role_catalog_source": {
    "path": "/app/data/role_catalog.json",
    "shape": "[{\"role\": str, \"inherits\": [str, ...], \"rules\": [{\"permission\": str, \"effect\": str}, ...]}, ...]"
  },
  "policy_source": {
    "path": "/app/data/access_policies.json",
    "shape": "{\"default\": {field: int, ...}, \"permission_overrides\": {permission: {field: int, ...}, ...}}"
  },
  "runtime_budget_seconds": 90
}
